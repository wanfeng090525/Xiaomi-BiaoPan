<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 系统启动屏：品牌底色 + 应用图标，冷启动阶段即展示；
     与 Compose 层 LaunchSplash（同为 #F2F2F7 底）无缝衔接 -->
<resources>
    <style name="Theme.WatchFaceIdTool" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F2F2F7</item>
        <item name="android:navigationBarColor">#F2F2F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
