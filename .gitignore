# Gradle / Android 构建产物
.gradle/
build/
app/build/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
local.properties

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# 临时/日志
*.log

# 签名密钥：不入库（CI 由 GitHub Secrets 还原到 app/keystore/；本地用 keystore.properties）
app/keystore/
keystore.properties
*.jks
*.keystore

# 微验 SDK：.so 与 native 构建产物全部由 CI 用 NDK 从 app/src/main/jni 源码生成，不入库
# jniLibs 只保留 .gitkeep 占位，让目录在仓库里可见
app/src/main/jniLibs/*
!app/src/main/jniLibs/.gitkeep
app/src/main/jni/libs/
app/src/main/jni/obj/
app/src/main/jni/weiyan/wy_constants_enc.h